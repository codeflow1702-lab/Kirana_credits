@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');

:root {
  color-scheme: light;
  --bg: #f6f7f4; --surface: #ffffff; --surface-2: #f0f2ed;
  --text: #20251f; --muted: #737b70; --line: #e5e9e1;
  --accent: #456b50; --accent-hover: #36583f; --accent-soft: #e9f0e8;
  --red: #b6534b; --shadow: 0 8px 30px rgba(31, 42, 31, .045);
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #171b18; --surface: #202621; --surface-2: #29312b;
  --text: #edf1eb; --muted: #a0aa9f; --line: #343e36;
  --accent: #9ab89b; --accent-hover: #b0c9b0; --accent-soft: #2c3a2e;
  --red: #e28b82; --shadow: 0 8px 30px rgba(0,0,0,.12);
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font-family: "DM Sans", sans-serif; }
button, input { font: inherit; }
button { cursor: pointer; }
.hidden { display: none !important; }
.muted { color: var(--muted); }
.small-text { font-size: .88rem; }
.eyebrow { margin: 0 0 8px; color: var(--muted); font-size: .69rem; font-weight: 700; letter-spacing: .13em; }
.brand-mark { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 15px; background: var(--accent); color: white; font: 800 1.35rem Manrope, sans-serif; }
.brand-mark.small { width: 34px; height: 34px; border-radius: 11px; font-size: 1rem; }
.login-wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
.login-card { width: min(100%, 410px); padding: 42px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); }
.login-card .brand-mark { margin-bottom: 28px; }
h1, h2, p { margin-top: 0; }
h1, h2, .amount { font-family: Manrope, sans-serif; }
.login-card h1 { margin-bottom: 8px; font-size: 2rem; letter-spacing: -.04em; }
.login-card .muted { line-height: 1.6; margin-bottom: 28px; }
.button { min-height: 42px; border: 1px solid transparent; border-radius: 10px; padding: 0 15px; font-weight: 600; font-size: .9rem; transition: background .15s, border-color .15s; }
.button.primary { background: var(--accent); color: #fff; }
.button.primary:hover { background: var(--accent-hover); }
:root[data-theme="dark"] .button.primary { color: #172019; }
.button.secondary { background: var(--surface-2); color: var(--text); border-color: var(--line); }
.button.outline { background: transparent; color: var(--text); border-color: var(--line); }
.button.outline:hover, .button.secondary:hover { background: var(--surface-2); }
.button.full { width: 100%; }
.message { min-height: 18px; margin: 12px 0 0; color: var(--muted); font-size: .85rem; }
.message.error { color: var(--red); }
.topbar { height: 70px; padding: 0 max(24px, calc((100vw - 1160px)/2)); display: flex; align-items: center; justify-content: space-between; background: var(--surface); border-bottom: 1px solid var(--line); }
.brand { display: flex; align-items: center; gap: 11px; color: var(--text); text-decoration: none; font: 700 1rem Manrope, sans-serif; }
.top-actions, .user-area { display: flex; align-items: center; gap: 16px; }
.icon-button { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 10px; color: var(--text); background: var(--surface); font-size: 1.25rem; }
.user-area { gap: 10px; }
.user-name { color: var(--muted); font-size: .85rem; }
.avatar { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
.text-button { border: 0; background: none; color: var(--muted); font-size: .85rem; }
.main-content { width: min(1160px, calc(100% - 48px)); margin: 42px auto 70px; }
.page-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 28px; }
.page-heading h1 { margin-bottom: 5px; font-size: 2rem; letter-spacing: -.04em; }
.page-heading .muted { margin-bottom: 0; }
.month-control { display: grid; gap: 6px; color: var(--muted); font-size: .78rem; }
input { min-width: 0; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 9px; padding: 10px 12px; outline: none; }
input:focus { border-color: var(--accent); }
.summary-grid { display: grid; grid-template-columns: 1.35fr 1fr 1fr; gap: 16px; }
.summary-card, .content-card { background: var(--surface); border: 1px solid var(--line); border-radius: 15px; box-shadow: var(--shadow); }
.summary-card { min-height: 145px; padding: 22px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 9px; }
.balance-card { background: var(--accent-soft); border-color: transparent; }
.card-label { color: var(--muted); font-size: .82rem; }
.amount { font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 800; letter-spacing: -.045em; }
.card-note { color: var(--muted); font-size: .78rem; }
.action-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 22px 0; }
.spacer { flex: 1; }
.content-card { padding: 22px; margin-top: 18px; }
.section-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 18px; }
.section-heading h2 { margin: 0 0 5px; font-size: 1.12rem; letter-spacing: -.02em; }
.section-heading p { margin: 0; }
.search-input { width: min(240px, 45%); }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
th { padding: 12px 10px; color: var(--muted); font-size: .72rem; font-weight: 600; }
td { padding: 14px 10px; border-top: 1px solid var(--line); font-size: .87rem; }
.right { text-align: right; }
.type-pill { display: inline-block; padding: 5px 9px; border-radius: 20px; background: var(--surface-2); color: var(--muted); font-size: .73rem; }
.amount-purchase { color: var(--text); font-weight: 600; }
.amount-payment { color: var(--accent); font-weight: 600; }
.row-actions { display: inline-flex; gap: 8px; }
.row-actions button { padding: 4px 7px; border: 0; border-radius: 6px; color: var(--muted); background: var(--surface-2); font-size: .75rem; }
.row-actions button.delete { color: var(--red); }
.empty-state { padding: 30px 10px; color: var(--muted); text-align: center; }
.report-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 20px 0; }
.report-grid div { display: grid; gap: 8px; padding: 16px; border-radius: 11px; background: var(--surface-2); }
.report-grid strong { font: 700 1.25rem Manrope, sans-serif; }
.transaction-dialog { width: min(440px, calc(100% - 28px)); padding: 26px; border: 1px solid var(--line); border-radius: 18px; color: var(--text); background: var(--surface); box-shadow: 0 20px 70px rgba(0,0,0,.2); }
.transaction-dialog::backdrop { background: rgba(17, 23, 18, .45); }
.dialog-heading { display: flex; justify-content: space-between; align-items: start; margin-bottom: 22px; }
.dialog-heading h2 { margin: 0; font-size: 1.35rem; }
.transaction-dialog form > label { display: block; margin: 14px 0 7px; color: var(--muted); font-size: .82rem; }
.transaction-dialog form > input { width: 100%; }
.dialog-actions { display: flex; justify-content: end; gap: 9px; margin-top: 22px; }
@media (max-width: 760px) {
  .topbar { padding: 0 18px; }
  .main-content { width: calc(100% - 32px); margin-top: 28px; }
  .page-heading { align-items: start; flex-direction: column; }
  .summary-grid { grid-template-columns: 1fr 1fr; }
  .balance-card { grid-column: 1 / -1; }
  .action-row .spacer { display: none; }
  .action-row .button { flex: 1 1 calc(50% - 10px); }
  .report-grid { grid-template-columns: 1fr; }
  .user-name { display: none; }
}
@media (max-width: 430px) {
  .login-card { padding: 30px 24px; }
  .summary-grid { gap: 10px; }
  .summary-card { padding: 16px; min-height: 125px; }
  .amount { font-size: 1.45rem; }
  .content-card { padding: 16px; }
  .section-heading { align-items: start; flex-direction: column; }
  .search-input { width: 100%; }
  .action-row .button { flex-basis: 100%; }
}
@media print {
  body { background: white; color: #111; }
  .topbar, .action-row, .month-control, .row-actions, .search-input { display: none !important; }
  .main-content { width: 100%; margin: 0; }
  .summary-card, .content-card { box-shadow: none; break-inside: avoid; }
  .summary-grid { grid-template-columns: repeat(3, 1fr); }
  :root { --surface: #fff; --bg: #fff; --text: #111; --muted: #555; --line: #ddd; --surface-2: #f5f5f5; }
}
