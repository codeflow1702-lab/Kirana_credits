<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f7f4">
  <meta name="description" content="A simple personal Kirana credit ledger.">
  <title>Kirana Ledger V2</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Shown until Firebase restores the user's authentication state. -->
  <div id="startupView" class="startup-screen" role="status" aria-live="polite">
    <div class="brand-mark startup-mark">K</div>
    <div class="startup-spinner" aria-hidden="true"></div>
    <p>Opening your ledger…</p>
  </div>

  <div id="loginView" class="login-wrap hidden">
    <section class="login-card">
      <div class="brand-mark">K</div>
      <p class="eyebrow">PERSONAL LEDGER · V2</p>
      <h1>Kirana Ledger</h1>
      <p class="muted">A simple, private place to keep track of your shop balance.</p>
      <button id="loginBtn" class="button primary full">
        <span id="loginSpinner" class="button-spinner hidden" aria-hidden="true"></span>
        <span id="loginButtonText">Continue with Google</span>
      </button>
      <p id="loginMessage" class="message" role="status" aria-live="polite"></p>
    </section>
  </div>

  <div id="appView" class="app-shell hidden">
    <header class="topbar">
      <a class="brand" href="#top" aria-label="Kirana Ledger home">
        <span class="brand-mark small">K</span>
        <span>Kirana Ledger</span>
        <span class="version-tag">V2</span>
      </a>
      <div class="top-actions">
        <button id="themeBtn" class="icon-button" type="button" aria-label="Switch theme" title="Switch theme">◐</button>
        <div class="user-area">
          <img id="userPhoto" class="avatar hidden" alt="">
          <span id="userName" class="user-name"></span>
          <button id="logoutBtn" class="text-button" type="button">Sign out</button>
        </div>
      </div>
    </header>

    <main id="top" class="main-content">
      <div class="connection-row">
        <span id="connectionDot" class="connection-dot" aria-hidden="true"></span>
        <span id="connectionText">Connecting…</span>
        <span class="connection-separator">·</span>
        <span id="syncText">Waiting for your ledger</span>
      </div>

      <!-- A skeleton is shown until the first Firestore snapshot arrives. -->
      <section id="dashboardSkeleton" class="dashboard-skeleton" aria-label="Loading dashboard">
        <div class="skeleton-heading">
          <div class="skeleton-block skeleton-eyebrow"></div>
          <div class="skeleton-block skeleton-title"></div>
          <div class="skeleton-block skeleton-subtitle"></div>
        </div>
        <div class="skeleton-summary-grid">
          <div class="skeleton-card balance-skeleton"><div class="skeleton-block line-short"></div><div class="skeleton-block amount-line"></div><div class="skeleton-block line-medium"></div></div>
          <div class="skeleton-card"><div class="skeleton-block line-short"></div><div class="skeleton-block amount-line"></div><div class="skeleton-block line-medium"></div></div>
          <div class="skeleton-card"><div class="skeleton-block line-short"></div><div class="skeleton-block amount-line"></div><div class="skeleton-block line-medium"></div></div>
        </div>
        <div class="skeleton-actions">
          <div class="skeleton-block skeleton-button"></div><div class="skeleton-block skeleton-button"></div><div class="skeleton-block skeleton-button"></div>
        </div>
        <div class="skeleton-panel">
          <div class="skeleton-block skeleton-title small-title"></div>
          <div class="skeleton-block skeleton-search"></div>
          <div class="skeleton-table-row"><span></span><span></span><span></span><span></span></div>
          <div class="skeleton-table-row"><span></span><span></span><span></span><span></span></div>
          <div class="skeleton-table-row"><span></span><span></span><span></span><span></span></div>
        </div>
      </section>

      <div id="dashboardContent" class="hidden">
        <section class="page-heading">
          <div>
            <p class="eyebrow">YOUR OVERVIEW</p>
            <h1>Dashboard</h1>
            <p class="muted">Keep your monthly balance clear and up to date.</p>
          </div>
          <div class="month-control">
            <label for="monthFilter">Report month</label>
            <input id="monthFilter" type="month">
          </div>
        </section>

        <section class="summary-grid" aria-label="Balance summary">
          <article class="summary-card balance-card">
            <span class="card-label">Total outstanding</span>
            <strong id="totalBalance" class="amount">₹0.00</strong>
            <span class="card-note">All-time balance</span>
          </article>
          <article class="summary-card">
            <span class="card-label">Purchases this month</span>
            <strong id="monthPurchases" class="amount">₹0.00</strong>
            <span class="card-note">Added to your balance</span>
          </article>
          <article class="summary-card">
            <span class="card-label">Payments this month</span>
            <strong id="monthPayments" class="amount">₹0.00</strong>
            <span class="card-note">Paid to the shop</span>
          </article>
        </section>

        <section class="action-row" aria-label="Ledger actions">
          <button id="addPurchaseBtn" class="button primary" type="button">＋ Add purchase</button>
          <button id="addPaymentBtn" class="button secondary" type="button">＋ Record payment</button>
          <div class="action-spacer"></div>
          <button id="whatsappBtn" class="button outline" type="button">Share monthly summary</button>
          <button id="exportMonthBtn" class="button outline" type="button">Export month CSV</button>
          <button id="exportAllBtn" class="button outline" type="button">Export all CSV</button>
          <button id="printBtn" class="button outline" type="button">Save PDF</button>
        </section>

        <section class="content-card">
          <div class="section-heading">
            <div>
              <h2>Transactions</h2>
              <p class="muted small-text">Purchases and payments, newest first.</p>
            </div>
            <input id="searchInput" class="search-input" type="search" placeholder="Search transactions" aria-label="Search transactions">
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Date</th><th>Details</th><th>Type</th><th class="right">Amount</th><th class="right">Actions</th></tr></thead>
              <tbody id="transactionRows">
                <tr><td colspan="5" class="empty-state">Your transactions will appear here.</td></tr>
              </tbody>
            </table>
          </div>
          <p id="dataMessage" class="message" role="status" aria-live="polite"></p>
        </section>

        <section class="content-card report-card">
          <div class="section-heading">
            <div><h2>Monthly summary</h2><p class="muted small-text" id="reportMonthLabel"></p></div>
          </div>
          <div class="report-grid">
            <div><span class="card-label">Purchases</span><strong id="reportPurchases">₹0.00</strong></div>
            <div><span class="card-label">Payments</span><strong id="reportPayments">₹0.00</strong></div>
            <div><span class="card-label">Net change</span><strong id="reportNet">₹0.00</strong></div>
          </div>
          <p class="muted small-text">Outstanding balance = all recorded purchases minus all recorded payments.</p>
        </section>
      </div>
    </main>
  </div>

  <dialog id="transactionDialog" class="transaction-dialog">
    <form id="transactionForm">
      <div class="dialog-heading">
        <div><p class="eyebrow" id="dialogEyebrow">NEW ENTRY</p><h2 id="dialogTitle">Add purchase</h2></div>
        <button type="button" id="closeDialogBtn" class="icon-button" aria-label="Close dialog">×</button>
      </div>
      <input id="editId" type="hidden">
      <input id="entryType" type="hidden" value="purchase">
      <label for="entryAmount">Amount (₹)</label>
      <input id="entryAmount" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="e.g. 250" required>
      <label for="entryDate">Date</label>
      <input id="entryDate" type="date" required>
      <label for="entryDescription">Description</label>
      <input id="entryDescription" type="text" maxlength="100" placeholder="e.g. Rice, milk and vegetables">
      <div class="dialog-actions">
        <button type="button" id="cancelDialogBtn" class="button secondary">Cancel</button>
        <button type="submit" id="saveEntryBtn" class="button primary">
          <span id="saveSpinner" class="button-spinner hidden" aria-hidden="true"></span>
          <span id="saveButtonText">Save entry</span>
        </button>
      </div>
      <p id="formMessage" class="message" role="status" aria-live="polite"></p>
    </form>
  </dialog>

  <div id="toastRegion" class="toast-region" aria-live="polite" aria-atomic="true"></div>
  <script type="module" src="app.js"></script>
</body>
</html>
